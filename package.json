{
  "name": "dsh-zephyr-widget",
  "version": "0.3.37",
  "description": "A draggable Zephyr (防风) sticker widget floating in the bottom-right corner of the web UI.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AYGYSKY/zephyr-widget.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "widget",
    "desktop-pet",
    "sticker"
  ],
  "license": "MIT",
  "author": "AYGYSKY"
}
